---
import { type ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { Svg } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

interface Props {
  class?: string
  title: string
  tools: {
    name: string
    description: string
    href: string
    icon: Promise<typeof import('*.svg?raw')> | ImageMetadata
    darkIcon?: Promise<typeof import('*.svg?raw')> | ImageMetadata
    /** 图标本身是彩色 logo（如品牌官方彩色图标），渲染时保留原色；否则按主题前景色单色渲染 */
    color?: boolean
    /** 已弃用工具：整体加透明遮罩 + 角标展示弃用原因 */
    deprecated?: string
  }[]
}

const { class: className, title, tools, ...props } = Astro.props

function isImageMetadata(obj: unknown): obj is ImageMetadata {
  return typeof obj === 'object' && obj !== null && 'src' in obj
}
---

<div
  class={cn('not-prose flex flex-col rounded-xl border py-3 px-3 gap-y-3 sm:gap-y-4', className)}
  {...props}
>
  <div class='m-0 px-2 text-lg font-medium'>{title}</div>
  <div class='grid grid-cols-1 gap-x-2 gap-y-2 sm:grid-cols-2'>
    {
      tools.map((tool) => (
        <a class='group relative text-sm leading-normal no-underline' href={tool.href} target='_blank'>
          <div
            class={cn(
              'flex items-center gap-x-3 rounded-lg border border-transparent px-1.5 py-1 transition-colors hover:border-border hover:bg-muted',
              tool.deprecated && 'opacity-70 grayscale'
            )}
          >
            {tool.darkIcon ? (
              <>
                {isImageMetadata(tool.icon) ? (
                  <div class='size-10 rounded-lg bg-card p-2 dark:hidden'>
                    <Image src={tool.icon} alt={tool.name} class='h-full w-full object-contain' />
                  </div>
                ) : (
                  <Svg
                    src={tool.icon}
                    class={cn('size-10 rounded-lg bg-card p-2 dark:hidden', !tool.color && 'fill-foreground')}
                  />
                )}

                {isImageMetadata(tool.darkIcon) ? (
                  <div class='size-10 rounded-lg bg-card p-2 hidden dark:block'>
                    <Image
                      src={tool.darkIcon}
                      alt={tool.name}
                      class='h-full w-full object-contain'
                    />
                  </div>
                ) : (
                  <Svg
                    src={tool.darkIcon}
                    class={cn('size-10 rounded-lg bg-card p-2 hidden dark:block', !tool.color && 'fill-foreground')}
                  />
                )}
              </>
            ) : (
              <>
                {isImageMetadata(tool.icon) ? (
                  <div class='size-10 rounded-lg bg-card p-2'>
                    <Image src={tool.icon} alt={tool.name} class='h-full w-full object-contain' />
                  </div>
                ) : (
                  <Svg
                    src={tool.icon}
                    class={cn('size-10 rounded-lg bg-card p-2', !tool.color && 'fill-foreground')}
                  />
                )}
              </>
            )}
            <div class='z-20 flex flex-col'>
              <div class='font-medium text-foreground'>{tool.name}</div>
              <div class='font-normal'>{tool.description}</div>
            </div>
          </div>
          {tool.deprecated && (
            <>
              {/* 透明遮罩 */}
              <div
                class='pointer-events-none absolute inset-0 z-10 rounded-lg bg-foreground/5 shadow-inner'
                aria-hidden='true'
              />
              {/* 弃用角标 */}
              <span class='absolute end-1.5 top-1.5 z-20 rounded-md border bg-background/85 px-1.5 py-0.5 text-[11px] font-medium text-muted-foreground backdrop-blur-sm'>
                弃用·{tool.deprecated}
              </span>
            </>
          )}
        </a>
      ))
    }
  </div>
</div>
