---
import { Button, Collapse, Spoiler, Timeline } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'experience', text: '职业经历' },
  { depth: 2, slug: 'tools', text: '工具箱' },
  { depth: 2, slug: 'social-networks', text: '社交媒体' },
  { depth: 2, slug: 'about-blog', text: '关于博客' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Developer / Designer</p>
  <p>
    擅长用最小成本验证想法，找到真正的市场需求，再把业务规模化。
  </p>
  <p>
    Motto: Stay hungry, Stay foolish. <Spoiler>这里可以夹私货，比如为什么要演奏春日影！</Spoiler>
  </p>

  {/* experience */}
  <h2 id='experience'>职业经历</h2>
  <Timeline
    class='about-timeline'
      events={[
        {
          date: '2025～至今',
          content: `<p>本地生活 &amp; 使用AI构筑产品</p>
                      <ul>
                        <li>为 500 家药房提供代运营支持；</li>
                        <li>沉浸于 Vibe Coding，一人即一个完整的 Team，为自己制作产品，也为公司使用 AI 进行业务提效：
                          <ul>
                            <li><a href="https://dashboard.arminos.cn" target="_blank">XianyuFlip</a> — 帮助闲鱼卖家 24 小时自动销售</li>
                            <li><a href="https://yuanqihupo.com/" target="_blank">元气琥珀用户中心</a> — 专业的用户健康管理 &amp; 营销中心</li>
                          </ul>
                        </li>
                      </ul>`
        },
        {
          date: '2022～2024',
          content: `<p>本地生活业务负责人</p>
                      <ul>
                        <li>负责神犬外卖业务（淘宝闪购头部服务商），社群用户规模峰值超 200 万人，月订单破百万；</li>
                        <li>拿下淘宝闪购上海、宁波两座核心城市独家招商权限。</li>
                      </ul>`
        },
        {
          date: '2021～2022',
          content: `<p>跨境电商产品经理</p>
                      <ul>
                        <li>设计并上线商品中心，实现图片智能翻译且支持译后编辑，自动分发到各语种销售平台，上品人效提高 8 倍；</li>
                        <li>从 0-1 独立完成电商独立站搭建，快速验证东南亚电商业务模式，单站点月 UV 25w。</li>
                      </ul>`
        },
        {
          date: '2019～2021',
          content: `<p>社交电商产品经理</p>
                      <ul>
                        <li>从零构建社交分期电商平台，零研发验证 MVP 月销 ¥500 万+，上线首季度过亿 GMV。</li>
                      </ul>`
        },
        {
          date: '2018～2019',
          content: `<p>流利说用增小组</p>
                      <ul>
                        <li>最早做朋友圈打卡分享的团队，累计转发量破亿次（19 年 5 月微信下场限制朋友圈打卡病毒营销）。</li>
                      </ul>`
        }
      ]}
  />
  <style is:global>
    .about-timeline samp {
      text-align: left;
      line-height: 1.8;
    }
    @media (min-width: 640px) {
      .about-timeline samp {
        width: 7rem;
        min-width: 7rem;
      }
    }
    /* add breathing room between timeline events */
    .about-timeline > ul > li {
      padding-bottom: 1.25rem;
    }
    .about-timeline > ul > li:last-child {
      padding-bottom: 0;
    }
    .about-timeline p {
      margin: 0 0 0.375rem;
      text-align: left;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.8;
      letter-spacing: 0.01em;
    }
    .about-timeline ul {
      margin: 0.375rem 0 0;
      padding-inline-start: 1.25rem;
      list-style: disc;
      font-size: 0.9375rem;
      line-height: 1.8;
      letter-spacing: 0.01em;
    }
    .about-timeline ul ul {
      margin-top: 0.375rem;
    }
    .about-timeline li {
      margin-block: 0.375rem;
    }
  </style>

  {/* tools */}
  <h2 id='tools'>工具箱</h2>
  <p>日常使用的工具，按用途分类。</p>
  <ToolSection
    class='mb-5'
    title='AI'
    tools={[
      {
        name: 'Claude Code',
        description: '终端里的 AI 编程助手，擅长长任务与代码重构',
        href: 'https://claude.com/claude-code',
        icon: import('@/assets/tools/claude.svg?raw'),
        color: true
      },
      {
        name: 'Codex',
        description: 'OpenAI 的云端编程智能体，与 ChatGPT 深度集成',
        href: 'https://openai.com/codex',
        icon: import('@/assets/tools/codex.svg?raw')
      },
      {
        name: 'Trae',
        description: '字节跳动的 AI 原生 IDE',
        href: 'https://www.trae.ai',
        icon: import('@/assets/tools/trae.svg?raw'),
        color: true
      },
      {
        name: 'Hermes',
        description: 'Nous Research 开源的自主 AI 智能体，持久记忆 + 技能自进化',
        href: 'https://hermes-agent.org/',
        icon: import('@/assets/tools/hermes.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='开发'
    tools={[
      {
        name: 'VS Code',
        description: '主力代码编辑器',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw'),
        color: true
      },
      {
        name: 'GitHub',
        description: '代码托管与协作平台',
        href: 'https://github.com/',
        icon: import('@/assets/tools/github.svg?raw'),
        color: true
      },
      {
        name: 'CloudFlare',
        description: 'CDN、DNS 与边缘服务',
        href: 'https://www.cloudflare.com/',
        icon: import('@/assets/tools/cloudflare.svg?raw'),
        color: true
      },
      {
        name: 'UTM',
        description: 'macOS 免费虚拟机，可运行 Windows / Linux',
        href: 'https://mac.getutm.app/',
        icon: import('@/assets/tools/utm.svg?raw'),
        color: true
      },
      {
        name: '影刀RPA',
        description: '自动化流程机器人',
        href: 'https://www.yingdao.com/',
        icon: import('@/assets/tools/yingdao.svg?raw'),
        color: true,
        deprecated: 'AI替代'
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='写作'
    tools={[
      {
        name: 'Obsidian',
        description: '本地优先的知识库笔记',
        href: 'https://obsidian.md/',
        icon: import('@/assets/tools/obsidian.svg?raw'),
        color: true
      },
      {
        name: 'Xmind',
        description: '思维导图工具',
        href: 'https://xmind.app/',
        icon: import('@/assets/tools/xmind.svg?raw')
      },
      {
        name: '飞书多维表格',
        description: '在线结构化表格，团队协作管理',
        href: 'https://www.feishu.cn/product/bitable',
        icon: import('@/assets/tools/larkbase.svg?raw'),
        color: true
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='设计与媒体'
    tools={[
      {
        name: 'Figma',
        description: '协作式 UI/UX 设计工具',
        href: 'https://www.figma.com/',
        icon: import('@/assets/tools/figma.svg?raw'),
        color: true
      },
      {
        name: 'Axure',
        description: '原型设计与交互文档',
        href: 'https://www.axure.com/',
        icon: import('@/assets/tools/axure.svg?raw'),
        color: true
      },
      {
        name: 'Premiere',
        description: '视频剪辑',
        href: 'https://www.adobe.com/products/premiere',
        icon: import('@/assets/tools/premiere.svg?raw'),
        color: true
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='开发环境'
    tools={[
      {
        name: 'MacOS',
        description: '主力开发系统',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw'),
        color: true
      },
      {
        name: 'Ubuntu',
        description: 'Linux 服务器与开发环境',
        href: 'https://ubuntu.com/',
        icon: import('@/assets/tools/ubuntu.svg?raw'),
        color: true
      },
      {
        name: 'Windows11',
        description: '备用系统',
        href: 'https://www.microsoft.com/windows',
        icon: import('@/assets/tools/windows11.svg?raw'),
        color: true
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>社交媒体</h2>
  <p>
    你可以在以下平台找到我：
  </p>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/rufus-fan',
        text: 'followers',
        api: 'github/rufus-fan'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/profiles/76561198179771750',
        text: 'games',
        api: 'steamgames/76561198179771750'
      }
    ]}
  />

  {/* about-blog */}
  <h2 id='about-blog'>关于博客</h2>
  <p>
    本站基于以下项目/服务提供商的资源和技术支持：
  </p>
  <ul>
    <li>域名: <a href='https://www.aliyun.com/' target='_blank'>Aliyun</a></li>
    <li>
      框架 & 主题: <a href='https://astro.build/' target='_blank'>Astro</a> + <a
        href='https://github.com/cworld1/astro-theme-pure'
        target='_blank'>Astro Theme Pure</a
      >
    </li>
    <li>站点托管&CI/CD: <a href='https://vercel.com/' target='_blank'>Vercel</a></li>
    <li>评论系统: <a href='https://waline.js.org' target='_blank'>Waline</a></li>
    <li>数据存储: <a href='https://neon.com/' target='_blank'>Neno</a></li>
    <li>
      访问量统计: <a href='https://waline.js.org/' target='_blank'>Waline</a>
      {/* <a href='https://umami.is/' target='_blank'>Umami</a> */}
    </li>
    <li>粉丝数统计: <a href='https://github.com/spencerwooo/substats' target='_blank'>Substats</a></li>
  </ul>
</PageLayout>
